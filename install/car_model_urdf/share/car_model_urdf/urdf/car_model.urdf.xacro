<?xml version="1.0"?>
<robot name="two_wheel_diff_car"
       xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="footprint_radius" value="0.001"/>

  <xacro:property name="chassis_length" value="0.215"/>
  <xacro:property name="chassis_width" value="0.130"/>
  <xacro:property name="chassis_height" value="0.070"/>
  <xacro:property name="chassis_mass" value="1.0"/>

  <xacro:property name="wheel_radius" value="0.024"/>
  <xacro:property name="wheel_width" value="0.0192"/>
  <xacro:property name="wheel_mass" value="0.12"/>
  <xacro:property name="wheel_x" value="-0.070"/>
  <xacro:property name="wheel_y" value="0.0843"/>

  <xacro:property name="bracket_x_size" value="0.040"/>
  <xacro:property name="bracket_thickness" value="0.006"/>
  <xacro:property name="bracket_height" value="0.045"/>
  <xacro:property name="bracket_mass" value="0.05"/>
  <xacro:property name="bracket_arm_length" value="${wheel_y - chassis_width / 2.0}"/>
  <xacro:property name="bracket_plate_z" value="${bracket_height / 2.0 - 0.010}"/>

  <xacro:property name="caster_radius" value="0.0125"/>
  <xacro:property name="caster_mass" value="0.03"/>
  <xacro:property name="caster_x" value="0.075"/>

  <xacro:property name="laser_x" value="${-chassis_length / 2.0 + 0.120}"/>
  <xacro:property name="laser_y" value="0.0"/>
  <xacro:property name="laser_radius" value="0.03025"/>
  <xacro:property name="laser_height" value="0.016"/>
  <xacro:property name="laser_mass" value="0.10"/>

  <xacro:property name="support_radius" value="0.015"/>
  <xacro:property name="support_height" value="0.049"/>
  <xacro:property name="support_mass" value="0.05"/>
  <xacro:property name="support_z" value="${chassis_height + support_height / 2.0}"/>
  <xacro:property name="laser_support_to_laser_z" value="${support_height / 2.0 + laser_height / 2.0}"/>

  <material name="black">
    <color rgba="0.08 0.08 0.08 1"/>
  </material>
  <material name="gray">
    <color rgba="0.45 0.45 0.45 1"/>
  </material>
  <material name="blue">
    <color rgba="0.05 0.25 0.85 1"/>
  </material>
  <material name="red">
    <color rgba="0.90 0.05 0.05 1"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.45 0.05 1"/>
  </material>

  <xacro:macro name="box_inertial" params="mass x y z origin_xyz">
    <inertial>
      <origin xyz="${origin_xyz}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (y*y + z*z) / 12.0}"
        ixy="0" ixz="0"
        iyy="${mass * (x*x + z*z) / 12.0}"
        iyz="0"
        izz="${mass * (x*x + y*y) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="y_cylinder_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}"
        ixy="0" ixz="0"
        iyy="${mass * radius*radius / 2.0}"
        iyz="0"
        izz="${mass * (3.0*radius*radius + length*length) / 12.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="z_cylinder_inertial" params="mass radius length">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${mass * (3.0*radius*radius + length*length) / 12.0}"
        ixy="0" ixz="0"
        iyy="${mass * (3.0*radius*radius + length*length) / 12.0}"
        iyz="0"
        izz="${mass * radius*radius / 2.0}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="${2.0 * mass * radius*radius / 5.0}"
        ixy="0" ixz="0"
        iyy="${2.0 * mass * radius*radius / 5.0}"
        iyz="0"
        izz="${2.0 * mass * radius*radius / 5.0}"/>
    </inertial>
  </xacro:macro>

  <link name="base_footprint">
    <visual>
      <origin xyz="0 0 ${footprint_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${footprint_radius}"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${footprint_radius}" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${footprint_radius}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 ${wheel_radius}" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${chassis_height / 2.0}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertial
      mass="${chassis_mass}"
      x="${chassis_length}"
      y="${chassis_width}"
      z="${chassis_height}"
      origin_xyz="0 0 ${chassis_height / 2.0}"/>
  </link>

  <xacro:macro name="drive_wheel" params="prefix side_sign">
    <link name="${prefix}_wheel_bracket_link">
      <visual>
        <origin xyz="0 ${side_sign * bracket_thickness / 2.0} ${bracket_plate_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${bracket_x_size} ${bracket_thickness} ${bracket_height}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 ${side_sign * bracket_thickness / 2.0} ${bracket_plate_z}" rpy="0 0 0"/>
        <geometry>
          <box size="${bracket_x_size} ${bracket_thickness} ${bracket_height}"/>
        </geometry>
      </collision>

      <visual>
        <origin xyz="0 ${side_sign * bracket_arm_length / 2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${bracket_x_size} ${bracket_arm_length} ${bracket_thickness}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 ${side_sign * bracket_arm_length / 2.0} 0" rpy="0 0 0"/>
        <geometry>
          <box size="${bracket_x_size} ${bracket_arm_length} ${bracket_thickness}"/>
        </geometry>
      </collision>

      <xacro:box_inertial
        mass="${bracket_mass}"
        x="${bracket_x_size}"
        y="${bracket_arm_length}"
        z="${bracket_height}"
        origin_xyz="0 ${side_sign * bracket_arm_length / 2.0} ${bracket_plate_z}"/>
    </link>

    <joint name="${prefix}_wheel_bracket_joint" type="fixed">
      <origin xyz="${wheel_x} ${side_sign * chassis_width / 2.0} 0" rpy="0 0 0"/>
      <parent link="base_link"/>
      <child link="${prefix}_wheel_bracket_link"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi / 2.0} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <xacro:y_cylinder_inertial
        mass="${wheel_mass}"
        radius="${wheel_radius}"
        length="${wheel_width}"/>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <origin xyz="0 ${side_sign * bracket_arm_length} 0" rpy="0 0 0"/>
      <parent link="${prefix}_wheel_bracket_link"/>
      <child link="${prefix}_wheel_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.05" friction="0.02"/>
    </joint>
  </xacro:macro>

  <xacro:drive_wheel prefix="left" side_sign="1"/>
  <xacro:drive_wheel prefix="right" side_sign="-1"/>

  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${caster_mass}" radius="${caster_radius}"/>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <origin xyz="${caster_x} 0 ${caster_radius - wheel_radius}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_caster_link"/>
  </joint>

  <link name="laser_support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${support_radius}" length="${support_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${support_radius}" length="${support_height}"/>
      </geometry>
    </collision>
    <xacro:z_cylinder_inertial
      mass="${support_mass}"
      radius="${support_radius}"
      length="${support_height}"/>
  </link>

  <joint name="laser_support_joint" type="fixed">
    <origin xyz="${laser_x} ${laser_y} ${support_z}" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_support_link"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="${laser_radius}" length="${laser_height}"/>
      </geometry>
    </collision>
    <xacro:z_cylinder_inertial
      mass="${laser_mass}"
      radius="${laser_radius}"
      length="${laser_height}"/>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 ${laser_support_to_laser_z}" rpy="0 0 0"/>
    <parent link="laser_support_link"/>
    <child link="laser_frame"/>
  </joint>

</robot>