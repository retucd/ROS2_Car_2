<?xml version="1.0" encoding="UTF-8"?>
<robot name="two_wheel_diff_car">

  <!-- ×ø±êÔ¼¶¨£ºX ÏòÇ°£¬Y Ïò×ó£¬Z ÏòÉÏ -->

  <material name="black"><color rgba="0.08 0.08 0.08 1"/></material>
  <material name="gray"><color rgba="0.45 0.45 0.45 1"/></material>
  <material name="blue"><color rgba="0.05 0.25 0.85 1"/></material>
  <material name="red"><color rgba="0.90 0.05 0.05 1"/></material>
  <material name="orange"><color rgba="0.95 0.45 0.05 1"/></material>

  <link name="base_footprint">
    <visual>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry><sphere radius="0.001"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry><sphere radius="0.001"/></geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.024" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.195 0.128 0.035"/></geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <geometry><box size="0.195 0.128 0.035"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.0175" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0014674167" ixy="0" ixz="0"
               iyy="0.0032708333" iyz="0"
               izz="0.0045340833"/>
    </inertial>
  </link>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.024" length="0.0192"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.024" length="0.0192"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0000209664" ixy="0" ixz="0"
               iyy="0.00003456" iyz="0"
               izz="0.0000209664"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.070 0.07485 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.024" length="0.0192"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry><cylinder radius="0.024" length="0.0192"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia ixx="0.0000209664" ixy="0" ixz="0"
               iyy="0.00003456" iyz="0"
               izz="0.0000209664"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.070 -0.07485 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0125"/></geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.0125"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia ixx="0.000001875" ixy="0" ixz="0"
               iyy="0.000001875" iyz="0"
               izz="0.000001875"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <origin xyz="0.075 0 -0.0115" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_caster_link"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.028" length="0.040"/></geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><cylinder radius="0.028" length="0.040"/></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia ixx="0.0000329333" ixy="0" ixz="0"
               iyy="0.0000329333" iyz="0"
               izz="0.0000392"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <!-- 0.055 = 0.035 + 0.040 / 2£¬À×´ïµ×ÃæÌù×¡µ×ÅÌÉÏ±íÃæ -->
    <origin xyz="0.05 0 0.055" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_frame"/>
  </joint>

</robot>vvvvvvvv