<?xml version="1.0"?>
<robot name="two_wheel_diff_car">

  <material name="black">
    <color rgba="0.08 0.08 0.08 1"/>
  </material>
  <material name="gray">
    <color rgba="0.45 0.45 0.45 1"/>
  </material>
  <material name="blue">
    <color rgba="0.05 0.25 0.85 1"/>
  </material>
  <material name="red">
    <color rgba="0.90 0.05 0.05 1"/>
  </material>
  <material name="orange">
    <color rgba="0.95 0.45 0.05 1"/>
  </material>

  <link name="base_footprint">
    <visual>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_footprint_joint" type="fixed">
    <origin xyz="0 0 0.024" rpy="0 0 0"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.215 0.130 0.070"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.215 0.130 0.070"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="0.0018166667" ixy="0" ixz="0"
        iyy="0.0042604167" iyz="0"
        izz="0.0052604167"/>
    </inertial>
  </link>

  <link name="left_wheel_bracket_link">
    <visual>
      <origin xyz="0 0.003 0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.006 0.045"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0.003 0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.006 0.045"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0.00965 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.0193 0.006"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 0.00965 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.0193 0.006"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0.00965 0.0125" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.0000099895" ixy="0" ixz="0"
        iyy="0.0000151042" iyz="0"
        izz="0.0000082187"/>
    </inertial>
  </link>

  <joint name="left_wheel_bracket_joint" type="fixed">
    <origin xyz="-0.070 0.065 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_bracket_link"/>
  </joint>

  <link name="left_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.0192"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.0192"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia
        ixx="0.0000209664" ixy="0" ixz="0"
        iyy="0.00003456" iyz="0"
        izz="0.0000209664"/>
    </inertial>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <origin xyz="0 0.0193 0" rpy="0 0 0"/>
    <parent link="left_wheel_bracket_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="right_wheel_bracket_link">
    <visual>
      <origin xyz="0 -0.003 0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.006 0.045"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.003 0.0125" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.006 0.045"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 -0.00965 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.0193 0.006"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0 -0.00965 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.040 0.0193 0.006"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 -0.00965 0.0125" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.0000099895" ixy="0" ixz="0"
        iyy="0.0000151042" iyz="0"
        izz="0.0000082187"/>
    </inertial>
  </link>

  <joint name="right_wheel_bracket_joint" type="fixed">
    <origin xyz="-0.070 -0.065 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_bracket_link"/>
  </joint>

  <link name="right_wheel_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.0192"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
      <geometry>
        <cylinder radius="0.024" length="0.0192"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.12"/>
      <inertia
        ixx="0.0000209664" ixy="0" ixz="0"
        iyy="0.00003456" iyz="0"
        izz="0.0000209664"/>
    </inertial>
  </link>

  <joint name="right_wheel_joint" type="continuous">
    <origin xyz="0 -0.0193 0" rpy="0 0 0"/>
    <parent link="right_wheel_bracket_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.05" friction="0.02"/>
  </joint>

  <link name="front_caster_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <sphere radius="0.0125"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.03"/>
      <inertia
        ixx="0.000001875" ixy="0" ixz="0"
        iyy="0.000001875" iyz="0"
        izz="0.000001875"/>
    </inertial>
  </link>

  <joint name="front_caster_joint" type="fixed">
    <origin xyz="0.075 0 -0.0115" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="front_caster_link"/>
  </joint>

  <link name="laser_support_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.049"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.015" length="0.049"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia
        ixx="0.0000128167" ixy="0" ixz="0"
        iyy="0.0000128167" iyz="0"
        izz="0.000005625"/>
    </inertial>
  </link>

  <joint name="laser_support_joint" type="fixed">
    <origin xyz="0.0125 0 0.0945" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_support_link"/>
  </joint>

  <link name="laser_frame">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03025" length="0.016"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.03025" length="0.016"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.10"/>
      <inertia
        ixx="0.0000250099" ixy="0" ixz="0"
        iyy="0.0000250099" iyz="0"
        izz="0.0000457531"/>
    </inertial>
  </link>

  <joint name="laser_joint" type="fixed">
    <origin xyz="0 0 0.0325" rpy="0 0 0"/>
    <parent link="laser_support_link"/>
    <child link="laser_frame"/>
  </joint>

</robot>